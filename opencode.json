{
    "$schema": "https://opencode.ai/config.json",
    
    "enabled_providers": ["opencode", "openai"],

    "disabled_providers": ["anthropic", "gemini"],
  
    "permission": {
      "*": "allow",
  
      "read": {
        "*": "allow",
        "*.env": "deny",
        "*.env.*": "deny",
        "*.env.example": "allow"
      },
  
      "edit": "ask",
  
      "bash": {
        "*": "ask",
        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",
        "git checkout*": "ask",
        "git commit*": "ask",
        "git push*": "deny",
        "rm *": "deny",
        "rm -rf *": "deny"
      },
  
      "external_directory": {
        "**": "ask"
      },
  
      "webfetch": "ask",
      "websearch": "ask",
  
      "doom_loop": "ask"
    },
  
    "lsp": true,
    "formatter": true,
  
    "share": "manual",
  
    "watcher": {
      "ignore": [
        "node_modules/**",
        "dist/**",
        ".next/**",
        "build/**",
        ".git/**"
      ]
    }
  }
  